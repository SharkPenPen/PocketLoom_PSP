get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED DEVKITPRO)
  if(DEFINED ENV{DEVKITPRO})
    set(DEVKITPRO "$ENV{DEVKITPRO}" CACHE PATH "devkitPro root")
  else()
    set(DEVKITPRO "C:/devkitPro" CACHE PATH "devkitPro root")
  endif()
endif()
set(DEVKITARM "${DEVKITPRO}/devkitARM")
set(CTRULIB "${DEVKITPRO}/libctru")
if(NOT EXISTS "${DEVKITARM}/bin/arm-none-eabi-g++" AND NOT EXISTS "${DEVKITARM}/bin/arm-none-eabi-g++.exe")
  message(FATAL_ERROR "devkitARM compiler not found: ${DEVKITARM}")
endif()
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(_3ds_exe "")
if(EXISTS "${DEVKITARM}/bin/arm-none-eabi-g++.exe")
  set(_3ds_exe ".exe")
endif()
set(CMAKE_C_COMPILER "${DEVKITARM}/bin/arm-none-eabi-gcc${_3ds_exe}")
set(CMAKE_CXX_COMPILER "${DEVKITARM}/bin/arm-none-eabi-g++${_3ds_exe}")
set(CMAKE_AR "${DEVKITARM}/bin/arm-none-eabi-ar${_3ds_exe}")
set(CMAKE_RANLIB "${DEVKITARM}/bin/arm-none-eabi-ranlib${_3ds_exe}")
set(CMAKE_STRIP "${DEVKITARM}/bin/arm-none-eabi-strip${_3ds_exe}")
set(CMAKE_C_COMPILER_WORKS 1)
set(CMAKE_CXX_COMPILER_WORKS 1)
set(_3ds_arch "-march=armv6k -mtune=mpcore -mfloat-abi=hard -mtp=soft")
set(_3ds_common "${_3ds_arch} -mword-relocations -D__3DS__ -pipe")
set(CMAKE_C_FLAGS_INIT "${_3ds_common}")
set(CMAKE_CXX_FLAGS_INIT "${_3ds_common}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-specs=3dsx.specs ${_3ds_arch}")
set(3DS ON CACHE BOOL "Building for Nintendo 3DS" FORCE)
